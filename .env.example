# Copy to .env (repo root) for `docker compose up`. This file configures
# both the postgres and backend services — see docker-compose.yml.
# Never commit the real .env (it's already in .gitignore).

# --- PostgreSQL (used by both the postgres service and the backend's
#     DATABASE_URL, which docker-compose.yml builds from these) ---
POSTGRES_DB=chunki
POSTGRES_USER=chunki
# Local-dev-only default below is fine for `docker compose up` on your own
# machine. Set a real secret for anything shared/deployed.
POSTGRES_PASSWORD=chunki_dev_password

# --- Google OAuth (see apps/server/README.md for how to obtain these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI configured on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- Sessions ---
# Signs the short-lived OAuth state/nonce/PKCE cookie. 32+ random characters;
# generate with e.g. `openssl rand -base64 32`. No default — the backend
# refuses to start without one.
SESSION_SECRET=

# Where the backend redirects back to after login, and the allowed CORS origin.
FRONTEND_URL=http://localhost:5173
