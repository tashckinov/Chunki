# Copy to .env (repo root) for `docker compose up`. This file configures
# both the postgres and backend services — see docker-compose.yml.
# Never commit the real .env (it's already in .gitignore).

# development = local, same-site setup (localhost frontend + localhost backend).
# production  = deployed setup where the frontend (GitHub Pages) and backend
#               (this VPS/host) are on different domains — see the notes below.
NODE_ENV=development

# --- PostgreSQL (used by both the postgres service and the backend's
#     DATABASE_URL, which docker-compose.yml builds from these) ---
POSTGRES_DB=chunki
POSTGRES_USER=chunki
# Local-dev-only default below is fine for `docker compose up` on your own
# machine. Set a real secret for anything shared/deployed.
POSTGRES_PASSWORD=chunki_dev_password

# --- Google OAuth (see apps/server/README.md for how to obtain these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI configured on the Google OAuth client,
# and must be reachable over the public internet (HTTPS) once NODE_ENV=production —
# Google will redirect real users' browsers here.
#   dev:  http://localhost:8787/api/auth/google/callback
#   prod: https://api.yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- Sessions ---
# Signs the short-lived OAuth state/nonce/PKCE cookie. 32+ random characters;
# generate with e.g. `openssl rand -base64 32`. No default — the backend
# refuses to start without one.
SESSION_SECRET=

# --- Frontend (GitHub Pages) ---
# Full URL (with path) the backend redirects the browser to after login.
#   dev:  http://localhost:5173
#   prod: https://<your-github-username>.github.io/Chunki
FRONTEND_URL=http://localhost:5173

# The bare origin (scheme+host[:port], NO path) allowed to call the backend
# with credentials — must match the browser's Origin header exactly, so it
# CANNOT include GitHub Pages' /Chunki path even though FRONTEND_URL does.
#   dev:  http://localhost:5173
#   prod: https://<your-github-username>.github.io
CORS_ORIGIN=http://localhost:5173

# When NODE_ENV=production, session/OAuth cookies switch to
# SameSite=None; Secure automatically (required for the GitHub-Pages-frontend
# / VPS-backend cross-site setup) — this REQUIRES the backend to be served
# over real HTTPS (put a reverse proxy like Caddy/nginx with a TLS cert in
# front of it; the Fastify process itself only speaks plain HTTP). Cookies
# silently won't be sent otherwise, so don't set NODE_ENV=production without
# HTTPS actually in place.
