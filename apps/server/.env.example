# Copy to .env for running the backend directly with `npm run dev:server`
# (no Docker). If you're using `docker compose up`, use the .env.example at
# the repo root instead — Compose passes DATABASE_URL etc. into the
# container itself and this file isn't read there.

PORT=8787
CORS_ORIGIN=http://localhost:5173

# Postgres reachable from the host. If you started it via
# `docker compose up -d postgres`, its port is published to localhost, so
# this works even though the backend itself isn't running in Docker here.
DATABASE_URL=postgresql://chunki:chunki_dev_password@localhost:5432/chunki

# --- Google OAuth (see README.md "Google OAuth setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# 32+ random characters, e.g. `openssl rand -base64 32`. Signs the
# short-lived OAuth state/nonce/PKCE cookie. No default — required.
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173

# GRADING_PROVIDER=mock|anthropic
# Omit to auto-select: "anthropic" in production or whenever ANTHROPIC_API_KEY is set, "mock" otherwise.
# GRADING_PROVIDER=mock

# Required when the anthropic provider is active. Never sent to the frontend.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Chunk production-check judge (is a free-text answer active use of a chunk,
# not just correct meaning?) — same optional/auto-select shape as grading
# above, via OpenRouter instead of Anthropic directly.
# PRODUCTION_JUDGE_PROVIDER=mock|openrouter
# Omit to auto-select: "openrouter" in production or whenever OPENROUTER_API_KEY is set, "mock" otherwise.
# PRODUCTION_JUDGE_PROVIDER=mock

# Required when the openrouter provider is active. Never sent to the frontend.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Subscription payments via Lava.top (optional) — see README.md's
#     "Payments (Lava.top)" section for how to get all of these. ---
# PAYMENT_PROVIDER=mock|lava_top
# Omit to auto-select: "lava_top" in production or whenever LAVA_TOP_API_KEY is set, "mock" otherwise.
# PAYMENT_PROVIDER=mock

# Required when the lava_top provider is active. Never sent to the frontend.
# LAVA_TOP_API_KEY=...
# LAVA_TOP_BASE_URL=https://gate.lava.top

# The checkout stepper lets the learner pick both plan and currency, so
# there's one offerId per (plan, currency) pair — create all four Offers in
# Lava.top's dashboard (monthly/yearly × USD/EUR). Paste either the bare
# offerId or the full "copy link" Lava.top gives you for each Offer, e.g.
# https://app.lava.top/products/<productId>/<offerId> — both work.
# LAVA_TOP_OFFER_ID_MONTHLY_USD=...
# LAVA_TOP_OFFER_ID_MONTHLY_EUR=...
# LAVA_TOP_OFFER_ID_YEARLY_USD=...
# LAVA_TOP_OFFER_ID_YEARLY_EUR=...

# Verifies inbound webhook calls from Lava.top (HTTP Basic auth) — set the
# same login/password in Lava.top's dashboard under Интеграции → Webhook,
# pointed at https://<your-backend-domain>/api/payments/webhook/lava-top.
# LAVA_TOP_WEBHOOK_LOGIN=...
# LAVA_TOP_WEBHOOK_PASSWORD=...
