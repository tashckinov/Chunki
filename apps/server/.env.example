# Copy to .env for running the backend directly with `npm run dev:server`
# (no Docker). If you're using `docker compose up`, use the .env.example at
# the repo root instead — Compose passes DATABASE_URL etc. into the
# container itself and this file isn't read there.

PORT=8787
CORS_ORIGIN=http://localhost:5173

# Postgres reachable from the host. If you started it via
# `docker compose up -d postgres`, its port is published to localhost, so
# this works even though the backend itself isn't running in Docker here.
DATABASE_URL=postgresql://chunki:chunki_dev_password@localhost:5432/chunki

# --- Google OAuth (see README.md "Google OAuth setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# 32+ random characters, e.g. `openssl rand -base64 32`. Signs the
# short-lived OAuth state/nonce/PKCE cookie. No default — required.
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173

# GRADING_PROVIDER=mock|anthropic
# Omit to auto-select: "anthropic" in production or whenever ANTHROPIC_API_KEY is set, "mock" otherwise.
# GRADING_PROVIDER=mock

# Required when the anthropic provider is active. Never sent to the frontend.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
